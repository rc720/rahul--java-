5.Show an example of comparable and comparator?
package q5;
import java.util.*;
class Emp implements Comparable<Emp> {
    String name;
    double salary;
    public Emp(String name, double salary) {
        this.name   = name;
        this.salary = salary;
    }
    // Comparable — natural order by name
    @Override
    public int compareTo(Emp other) {
        return this.name.compareTo(other.name);
    }
    @Override
    public String toString() {
        return "Emp [name=" + name + ", salary=" + salary + "]";
    }
}
// Comparator — order by salary
class SalaryComparator implements Comparator<Emp> {
    @Override
    public int compare(Emp e1, Emp e2) {
        return Double.compare(e1.salary, e2.salary);
    }
}
public class Main {
    public static void main(String[] args) {
        List<Emp> list = new ArrayList<>();
        list.add(new Emp("rahul",  15000));
        list.add(new Emp("rohit", 12000));
        list.add(new Emp("Om",    18000));

        Collections.sort(list);                         // Comparable (by name)
        System.out.println("Sorted by name: " + list);

        list.sort(new SalaryComparator());               // Comparator (by salary)
        System.out.println("Sorted by salary: " + list);
    }
}

6.Show uses of wait() & notify() with an example.
package q6;
class SharedResource {
 boolean available = false;
 synchronized void produce(String item) throws InterruptedException {
     while (available) {
         wait();                
     }
     System.out.println("Produced: " + item);
     available = true;
     notify();                 

 synchronized void consume() throws InterruptedException {
     while (!available) {
         wait();               
     }
     System.out.println("Consumed item");
     available = false;
     notify();                 
 }
}
public class Main {
 public static void main(String[] args) {
     SharedResource res = new SharedResource();

     Thread producer = new Thread(() -> {
         try {
             res.produce("Medicine");
             res.produce("Report");
         } catch (InterruptedException e) { e.printStackTrace(); }
     });
     Thread consumer = new Thread(() -> {
         try {
             res.consume();
             res.consume();
         } catch (InterruptedException e) { e.printStackTrace(); }
     });
     producer.start();
     consumer.start();
 }
}

