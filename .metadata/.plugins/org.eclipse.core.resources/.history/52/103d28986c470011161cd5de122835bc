package q20;

class Emp {
	String name;
	int id;
	double sal;
	String address;

	public void dispInfo(String name, int id, double sal, String address) {
		// TODO Auto-generated method stub
		System.out.println(name);
		System.out.println(id);
		System.out.println(sal);
		System.out.println(address);
//		System.out.println("harsh");
	}

	public Emp(String name, int id, double sal, String address) {
		// TODO Auto-generated constructor stub
		this.name = name;
		this.id = id;
		this.sal = sal;
		this.address = address;
	}

	@Override
	public String toString() {
		return "Emp [name=" + name + ", id=" + id + ", sal=" + sal + ", address=" + address + "]";
	}

}

public class Main {
	public static void main(String[] args) {
		Emp emp = new Emp("Rahul", 12, 120, "borivali");
		System.out.println(emp);
		emp.dispInfo("Rahul", 120, 12000, "virar");
	}

}