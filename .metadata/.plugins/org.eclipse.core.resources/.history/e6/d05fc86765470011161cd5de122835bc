package q14;
public class Main {
	public String pub="public";
	protected String pro="protected";
	private String def="default";
	private String priv="private";
	public static void main(String[] args) {
		Main main = new Main();
		System.out.println("within package within a class: "+main.pub);
		System.out.println("within package within a class: "+main.pro);
		System.out.println("within package within a class: "+main.getDef());
		System.out.println("within package within a class: "+main.priv);
	}
	public String getDef() {
		return def;
	}
	public void setDef(String def) {
		this.def = def;
	}
}
