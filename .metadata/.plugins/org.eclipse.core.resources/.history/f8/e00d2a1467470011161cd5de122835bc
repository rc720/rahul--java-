package q15;

class Emp {
	 String name;
	 int    id;
	 double sal;
	 String address;
	 public Emp(String name, int id, double sal, String address) {
	     this.name    = name;
	     this.id      = id;
	     this.sal     = sal;
	     this.address = address;
	 }
	 @Override
	 public String toString() {
	     return "Emp [name=" + name + ", id=" + id
	             + ", sal=" + sal + ", address=" + address + "]";
	 }
	}
	public class Main {
	 public static void main(String[] args) {
	     Emp emp = new Emp("Rahul", 12, 12000, "Borivali");
	     System.out.println(emp);
	 }
	}
